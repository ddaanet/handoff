# Runtime handoff artifacts (regenerated each session)
.claude/handoff.md
# Listed but force-added by write-stage.sh: the task frame IS tracked, as a
# versioned trail paired with gitlore memory commits.
.claude/handoff-task.md
# Not force-added anywhere: the remainder ledger is working state, with none of
# that pairing value. Ignored means ignored.
.claude/handoff-todo.md

# Driver files for the rename and compaction watchers. Each exists for part of
# one turn (or one Stop -> compaction window) and is consumed by a hook.
.claude/autorename*
.claude/autocompact*

# Local-only Claude Code settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# uv-managed venv (created by `uv sync`; uv.lock IS tracked)
.venv/
.pytest_cache/
